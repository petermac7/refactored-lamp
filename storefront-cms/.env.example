# ── Local development ──────────────────────────────────────────────
# SQLite file used when POSTGRES_URL is not set
DATABASE_URL=file:./storefront.db
# Used to encrypt JWT tokens
PAYLOAD_SECRET=
# Used to configure CORS, format links and more. No trailing slash.
# Leave unset on Vercel: the production domain is detected automatically.
NEXT_PUBLIC_SERVER_URL=http://localhost:3100
# Secret used to authenticate cron jobs
CRON_SECRET=
# Used to validate preview requests
PREVIEW_SECRET=
# Site name used in page titles and social cards
NEXT_PUBLIC_SITE_NAME=Your Brand
# Admin login created by `pnpm seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Production (set by Vercel) ─────────────────────────────────────
# Postgres connection string. When set, Postgres is used instead of SQLite.
POSTGRES_URL=
# Vercel Blob token. When set, uploads are stored in Vercel Blob.
BLOB_READ_WRITE_TOKEN=
